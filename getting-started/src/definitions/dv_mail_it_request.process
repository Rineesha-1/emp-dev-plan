<process id="dv_mail_it_request.process" name="dv_mail_it_request.process" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <documentation textFormat="text/plain">
        <text><![CDATA[Tells the IT admin that a new equipment request is waiting. The engine posts the mail (recipients, subject, body below) to the devplan backend's mail relay, which sends it through the CaseFabric mailcatcher (http://localhost:1080).]]></text>
    </documentation>
    <input id="employeeName" name="employeeName"/>
    <input id="itEmail" name="itEmail"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation xmlns:cafienne="org.cafienne" class="org.cafienne.processtask.implementation.http.HTTPCallDefinition">
            <url>http://devplan-backend:8080/internal/mail</url>
            <method>POST</method>
            <post-content><![CDATA[{"to": "${itEmail}", "cc": "", "subject": "New equipment request: ${employeeName}", "html": "<div style='font-family: Arial, sans-serif; color: #111827'><p>HR has sent the IT &amp; equipment request for <b>${employeeName}</b>.</p><p>Open <i>My Tasks</i>, <b>Equipment request</b> at <a href='http://localhost:8090'>http://localhost:8090</a> to issue the equipment and set up the accounts.</p></div>"}]]></post-content>
            <http-headers>
                <http-header name="Content-Type">application/json</http-header>
                <http-header name="X-Mail-Token">devplan-mail-relay</http-header>
            </http-headers>
        </cafienne:implementation>
    </extensionElements>
</process>
