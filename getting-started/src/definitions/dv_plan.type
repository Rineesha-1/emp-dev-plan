<type xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne" id="dv_plan.type" name="dv_plan">
    <schema>
        <property id="sp_Plan_roundNo" name="roundNo" type="integer" multiplicity="ZeroOrOne" />
        <property id="sp_Plan_period" name="period" type="string" multiplicity="ZeroOrOne" />
        <property id="sp_Plan_goals" name="goals" type="object" multiplicity="ZeroOrMore">
            <schema id="sc_Plan_goals" name="goals">
                <property id="sp_Plan_goals_title" name="title" type="string" multiplicity="ZeroOrOne" />
                <property id="sp_Plan_goals_type" name="type" type="string" multiplicity="ZeroOrOne" />
                <property id="sp_Plan_goals_description" name="description" type="string" multiplicity="ZeroOrOne" />
                <property id="sp_Plan_goals_successCriteria" name="successCriteria" type="string" multiplicity="ZeroOrOne" />
                <property id="sp_Plan_goals_targetDate" name="targetDate" type="string" multiplicity="ZeroOrOne" format="date" />
            </schema>
        </property>
    </schema>
</type>
