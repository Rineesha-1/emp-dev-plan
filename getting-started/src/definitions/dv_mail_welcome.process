<process id="dv_mail_welcome.process" name="dv_mail_welcome.process" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <documentation textFormat="text/plain">
        <text><![CDATA[Welcome e-mail to the new joiner (private e-mail): username and where to log in. The password is set through the separate Keycloak e-mail. The engine posts the mail (recipients, subject, body below) to the devplan backend's mail relay, which sends it through the CaseFabric mailcatcher (http://localhost:1080).]]></text>
    </documentation>
    <input id="employeeName" name="employeeName"/>
    <input id="employeeEmail" name="employeeEmail"/>
    <input id="username" name="username"/>
    <input id="managerName" name="managerName"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation xmlns:cafienne="org.cafienne" class="org.cafienne.processtask.implementation.http.HTTPCallDefinition">
            <url>http://devplan-backend:8080/internal/mail</url>
            <method>POST</method>
            <post-content><![CDATA[{"to": "${employeeEmail}", "cc": "", "subject": "Welcome to CubeWorks, ${employeeName}", "html": "<div style='font-family: Arial, sans-serif; color: #111827'><h2>Welcome to CubeWorks, ${employeeName}!</h2><p>Your account has been created.</p><p><b>Username:</b> ${username}<br/><b>Log in at:</b> <a href='http://localhost:8090'>http://localhost:8090</a></p><p>You will receive a separate e-mail with a link to set your password.</p><p>Your manager is ${managerName}. See you soon!</p><p>HR, CubeWorks</p></div>"}]]></post-content>
            <http-headers>
                <http-header name="Content-Type">application/json</http-header>
                <http-header name="X-Mail-Token">devplan-mail-relay</http-header>
            </http-headers>
        </cafienne:implementation>
    </extensionElements>
</process>
