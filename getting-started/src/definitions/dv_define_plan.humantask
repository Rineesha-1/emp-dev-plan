<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="DefinePlan" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Define goals & plan. Owner: Employee. Starts empty in every round. The manager may also fill it in (delegation).]]></text>
        </documentation>
        <input id="i_Employee__define_plan" name="Employee" typeRef="dv_employee.type"/>
        <output id="o_Plan__define_plan" name="Plan" typeRef="dv_plan.type"/>
        <task-model>{
  "schema": {
    "title": "Define goals &amp; plan",
    "description": "Set the plan period and add your goals: what you want to develop, how you will know it is achieved and by when. The plan then goes to your manager for approval.",
    "type": "object",
    "required": [
      "Plan"
    ],
    "properties": {
      "Plan": {
        "type": "object",
        "title": "Development plan",
        "properties": {
          "period": {
            "type": "string",
            "title": "Plan period"
          },
          "goals": {
            "type": "array",
            "title": "Goals",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "title": "Goal"
                },
                "type": {
                  "type": "string",
                  "title": "Type",
                  "oneOf": [
                    {
                      "const": "SKILL",
                      "title": "Skill"
                    },
                    {
                      "const": "KNOWLEDGE",
                      "title": "Knowledge"
                    },
                    {
                      "const": "BEHAVIOUR",
                      "title": "Behaviour"
                    },
                    {
                      "const": "CAREER",
                      "title": "Career"
                    }
                  ]
                },
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "successCriteria": {
                  "type": "string",
                  "title": "How we know it is achieved"
                },
                "targetDate": {
                  "type": "string",
                  "title": "Target date",
                  "format": "date"
                }
              },
              "required": [
                "title",
                "type",
                "successCriteria",
                "targetDate"
              ]
            },
            "minItems": 1
          }
        },
        "x-on-complete": "submitPlan",
        "required": [
          "period",
          "goals"
        ]
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "Plan",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/Plan/properties/period"
          },
          {
            "type": "Control",
            "scope": "#/properties/Plan/properties/goals",
            "label": "Goals",
            "options": {
              "table": true
            }
          }
        ]
      }
    ]
  },
  "submitLabel": "Send for approval"
}</task-model>
    </cafienne:implementation>
</humanTask>
