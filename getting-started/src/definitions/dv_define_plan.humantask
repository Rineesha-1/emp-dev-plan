<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="DefinePlan" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Define goals & plan. Owner: Employee. Starts from the previous plan, if any. The manager may also fill it in (delegation).]]></text>
        </documentation>
        <input id="i_Employee__define_plan" name="Employee"/>
        <input id="i_Plan__define_plan" name="Plan"/>
        <output id="o_Plan__define_plan" name="Plan"/>
        <task-model><![CDATA[{
  "schema": {
    "title": "Define goals & plan",
    "description": "Set the plan period and add your goals: what you want to develop, how you will know it is achieved and by when. The plan then goes to your manager for approval.",
    "type": "object",
    "required": [
      "Plan"
    ],
    "properties": {
      "Employee": {
        "type": "object",
        "title": "Employee",
        "properties": {
          "employeeId": {
            "type": "string",
            "title": "Employee number"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "jobTitle": {
            "type": "string",
            "title": "Job title"
          },
          "managerId": {
            "type": "string",
            "title": "Manager number"
          },
          "managerName": {
            "type": "string",
            "title": "Manager"
          },
          "trigger": {
            "type": "string",
            "title": "Reason for the plan",
            "enum": [
              "ANNUAL_REVIEW",
              "NEW_ROLE",
              "CAREER_GROWTH",
              "PERFORMANCE_IMPROVEMENT",
              "ONBOARDING"
            ],
            "enumNames": [
              "Annual review",
              "New role",
              "Career growth",
              "Performance improvement",
              "Onboarding"
            ]
          }
        }
      },
      "Plan": {
        "type": "object",
        "title": "Development plan",
        "properties": {
          "period": {
            "type": "string",
            "title": "Plan period"
          },
          "goals": {
            "type": "array",
            "title": "Goals",
            "items": {
              "type": "object",
              "title": "Goal",
              "properties": {
                "title": {
                  "type": "string",
                  "title": "Goal"
                },
                "type": {
                  "type": "string",
                  "title": "Type",
                  "enum": [
                    "SKILL",
                    "KNOWLEDGE",
                    "BEHAVIOUR",
                    "CAREER"
                  ],
                  "enumNames": [
                    "Skill",
                    "Knowledge",
                    "Behaviour",
                    "Career"
                  ]
                },
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "successCriteria": {
                  "type": "string",
                  "title": "How we know it is achieved"
                },
                "targetDate": {
                  "type": "string",
                  "title": "Target date",
                  "format": "date"
                }
              },
              "required": [
                "title",
                "type",
                "successCriteria",
                "targetDate"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "period",
          "goals"
        ]
      }
    }
  },
  "uiSchema": {
    "Employee": {
      "ui:order": [
        "employeeId",
        "name",
        "jobTitle",
        "managerId",
        "managerName",
        "trigger"
      ],
      "ui:readonly": true
    },
    "Plan": {
      "ui:order": [
        "period",
        "goals"
      ],
      "goals": {
        "items": {
          "ui:order": [
            "title",
            "type",
            "description",
            "successCriteria",
            "targetDate"
          ],
          "description": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          },
          "successCriteria": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          }
        }
      }
    },
    "ui:order": [
      "Employee",
      "Plan"
    ]
  },
  "jsonforms": {
    "schema": {
      "title": "Define goals & plan",
      "description": "Set the plan period and add your goals: what you want to develop, how you will know it is achieved and by when. The plan then goes to your manager for approval.",
      "type": "object",
      "required": [
        "Plan"
      ],
      "properties": {
        "Employee": {
          "type": "object",
          "title": "Employee",
          "properties": {
            "employeeId": {
              "type": "string",
              "title": "Employee number"
            },
            "name": {
              "type": "string",
              "title": "Name"
            },
            "jobTitle": {
              "type": "string",
              "title": "Job title"
            },
            "managerId": {
              "type": "string",
              "title": "Manager number"
            },
            "managerName": {
              "type": "string",
              "title": "Manager"
            },
            "trigger": {
              "type": "string",
              "title": "Reason for the plan",
              "oneOf": [
                {
                  "const": "ANNUAL_REVIEW",
                  "title": "Annual review"
                },
                {
                  "const": "NEW_ROLE",
                  "title": "New role"
                },
                {
                  "const": "CAREER_GROWTH",
                  "title": "Career growth"
                },
                {
                  "const": "PERFORMANCE_IMPROVEMENT",
                  "title": "Performance improvement"
                },
                {
                  "const": "ONBOARDING",
                  "title": "Onboarding"
                }
              ]
            }
          }
        },
        "Plan": {
          "type": "object",
          "title": "Development plan",
          "properties": {
            "period": {
              "type": "string",
              "title": "Plan period"
            },
            "goals": {
              "type": "array",
              "title": "Goals",
              "items": {
                "type": "object",
                "title": "Goal",
                "properties": {
                  "title": {
                    "type": "string",
                    "title": "Goal"
                  },
                  "type": {
                    "type": "string",
                    "title": "Type",
                    "oneOf": [
                      {
                        "const": "SKILL",
                        "title": "Skill"
                      },
                      {
                        "const": "KNOWLEDGE",
                        "title": "Knowledge"
                      },
                      {
                        "const": "BEHAVIOUR",
                        "title": "Behaviour"
                      },
                      {
                        "const": "CAREER",
                        "title": "Career"
                      }
                    ]
                  },
                  "description": {
                    "type": "string",
                    "title": "Description"
                  },
                  "successCriteria": {
                    "type": "string",
                    "title": "How we know it is achieved"
                  },
                  "targetDate": {
                    "type": "string",
                    "title": "Target date",
                    "format": "date"
                  }
                },
                "required": [
                  "title",
                  "type",
                  "successCriteria",
                  "targetDate"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "period",
            "goals"
          ]
        }
      }
    },
    "submitLabel": "Send for approval",
    "uischema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Employee",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/Employee/properties/name",
              "options": {
                "readonly": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/Employee/properties/jobTitle",
              "options": {
                "readonly": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/Employee/properties/managerName",
              "options": {
                "readonly": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/Employee/properties/trigger",
              "options": {
                "readonly": true
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Development plan",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/Plan/properties/period"
            },
            {
              "type": "Control",
              "scope": "#/properties/Plan/properties/goals",
              "options": {
                "showSortButtons": false,
                "elementLabelProp": "title",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/title"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/type"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/description",
                      "options": {
                        "multi": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/successCriteria",
                      "options": {
                        "multi": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/targetDate"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  },
  "output": "Plan"
}]]></task-model>
    </cafienne:implementation>
</humanTask>
