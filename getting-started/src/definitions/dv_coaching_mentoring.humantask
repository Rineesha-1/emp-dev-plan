<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="CoachingMentoring" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Coaching and mentoring. Owner: Employee. Adds a COACHING activity to Activities.]]></text>
        </documentation>
        <input id="i_Plan__coaching_mentoring" name="Plan" typeRef="dv_plan.type"/>
        <output id="o_Activity__coaching_mentoring" name="Activity" typeRef="dv_activity.type"/>
        <task-model><![CDATA[{
  "schema": {
    "title": "Coaching and mentoring",
    "description": "Describe the coaching or mentoring, the goal it supports and its status.",
    "type": "object",
    "required": [
      "Activity"
    ],
    "properties": {
      "Plan": {
        "type": "object",
        "title": "Development plan",
        "properties": {
          "period": {
            "type": "string",
            "title": "Plan period"
          },
          "goals": {
            "type": "array",
            "title": "Goals",
            "items": {
              "type": "object",
              "title": "Goal",
              "properties": {
                "title": {
                  "type": "string",
                  "title": "Goal"
                },
                "type": {
                  "type": "string",
                  "title": "Type",
                  "enum": [
                    "SKILL",
                    "KNOWLEDGE",
                    "BEHAVIOUR",
                    "CAREER"
                  ],
                  "enumNames": [
                    "Skill",
                    "Knowledge",
                    "Behaviour",
                    "Career"
                  ]
                },
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "successCriteria": {
                  "type": "string",
                  "title": "How we know it is achieved"
                },
                "targetDate": {
                  "type": "string",
                  "title": "Target date",
                  "format": "date"
                }
              },
              "required": [
                "title",
                "type",
                "successCriteria",
                "targetDate"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "period",
          "goals"
        ]
      },
      "Activity": {
        "type": "object",
        "title": "Activity",
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "enum": [
              "COACHING"
            ],
            "enumNames": [
              "Coaching"
            ],
            "default": "COACHING"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "relatedGoal": {
            "type": "string",
            "title": "Supports goal"
          },
          "dueDate": {
            "type": "string",
            "title": "Due date",
            "format": "date"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "enum": [
              "PLANNED",
              "IN_PROGRESS",
              "DONE"
            ],
            "enumNames": [
              "Planned",
              "In progress",
              "Done"
            ]
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          }
        },
        "required": [
          "type",
          "description",
          "status"
        ]
      }
    }
  },
  "uiSchema": {
    "Plan": {
      "ui:order": [
        "period",
        "goals"
      ],
      "goals": {
        "items": {
          "ui:order": [
            "title",
            "type",
            "description",
            "successCriteria",
            "targetDate"
          ],
          "description": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          },
          "successCriteria": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          }
        },
        "ui:options": {
          "addable": false,
          "removable": false,
          "orderable": false
        },
        "ui:readonly": true
      },
      "ui:readonly": true
    },
    "Activity": {
      "ui:order": [
        "type",
        "description",
        "relatedGoal",
        "dueDate",
        "status",
        "outcome"
      ],
      "description": {
        "ui:widget": "textarea",
        "ui:options": {
          "rows": 3
        }
      },
      "outcome": {
        "ui:widget": "textarea",
        "ui:options": {
          "rows": 3
        }
      }
    },
    "ui:order": [
      "Plan",
      "Activity"
    ]
  },
  "submitLabel": "Save activity"
}]]></task-model>
    </cafienne:implementation>
</humanTask>
