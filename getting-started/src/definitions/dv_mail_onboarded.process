<process id="dv_mail_onboarded.process" name="dv_mail_onboarded.process" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <documentation textFormat="text/plain">
        <text><![CDATA[Tells HR (and the manager, in cc) that the new joiner is onboarded. The engine only triggers this with Employee.employeeId; the devplan backend resolves HR's and the manager's addresses and the employee's name from the employee directory (DB) and sends the mail through the CaseFabric mailcatcher (http://localhost:1080).]]></text>
    </documentation>
    <input id="employeeId" name="employeeId"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation xmlns:cafienne="org.cafienne" class="org.cafienne.processtask.implementation.http.HTTPCallDefinition">
            <url>http://devplan-backend:8080/internal/mail/onboarded</url>
            <method>POST</method>
            <post-content><![CDATA[{"employeeId": "${employeeId}"}]]></post-content>
            <http-headers>
                <http-header name="Content-Type">application/json</http-header>
                <http-header name="X-Mail-Token">devplan-mail-relay</http-header>
            </http-headers>
        </cafienne:implementation>
    </extensionElements>
</process>
