<process id="dv_mail_onboarded.process" name="dv_mail_onboarded.process" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <documentation textFormat="text/plain">
        <text><![CDATA[Tells HR (and the manager, in cc) that the new joiner is onboarded. The engine posts the mail (recipients, subject, body below) to the devplan backend's mail relay, which sends it through the CaseFabric mailcatcher (http://localhost:1080).]]></text>
    </documentation>
    <input id="employeeName" name="employeeName"/>
    <input id="hrEmail" name="hrEmail"/>
    <input id="managerEmail" name="managerEmail"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation xmlns:cafienne="org.cafienne" class="org.cafienne.processtask.implementation.http.HTTPCallDefinition">
            <url>http://devplan-backend:8080/internal/mail</url>
            <method>POST</method>
            <post-content><![CDATA[{"to": "${hrEmail}", "cc": "${managerEmail}", "subject": "Onboarding complete: ${employeeName}", "html": "<div style='font-family: Arial, sans-serif; color: #111827'><p><b>${employeeName}</b> is onboarded: every mandatory checklist item is done.</p><p>The development plan can now be started from the employee's case at <a href='http://localhost:8090'>http://localhost:8090</a>.</p></div>"}]]></post-content>
            <http-headers>
                <http-header name="Content-Type">application/json</http-header>
                <http-header name="X-Mail-Token">devplan-mail-relay</http-header>
            </http-headers>
        </cafienne:implementation>
    </extensionElements>
</process>
