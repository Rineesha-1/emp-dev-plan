<type xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne" id="development.type" name="development">
    <schema>
        <property id="sp_Employee" name="Employee" type="object" multiplicity="ExactlyOne">
            <schema id="sc_Employee" name="Employee">
                <property id="sp_Employee_employeeId" name="employeeId" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Employee_name" name="name" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Employee_jobTitle" name="jobTitle" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Employee_managerId" name="managerId" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Employee_managerName" name="managerName" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Employee_trigger" name="trigger" type="string" multiplicity="ZeroOrOne"/>
            </schema>
        </property>
        <property id="sp_Plan" name="Plan" type="object" multiplicity="ZeroOrOne">
            <schema id="sc_Plan" name="Plan">
                <property id="sp_Plan_period" name="period" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Plan_goals" name="goals" type="object" multiplicity="ZeroOrMore">
                    <schema id="sc_Plan_goals" name="goals">
                        <property id="sp_Plan_goals_title" name="title" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_Plan_goals_type" name="type" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_Plan_goals_description" name="description" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_Plan_goals_successCriteria" name="successCriteria" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_Plan_goals_targetDate" name="targetDate" type="string" multiplicity="ZeroOrOne" format="date"/>
                    </schema>
                </property>
            </schema>
        </property>
        <property id="sp_Approval" name="Approval" type="object" multiplicity="ZeroOrOne">
            <schema id="sc_Approval" name="Approval">
                <property id="sp_Approval_decision" name="decision" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Approval_comments" name="comments" type="string" multiplicity="ZeroOrOne"/>
            </schema>
        </property>
        <property id="sp_Activities" name="Activities" type="object" multiplicity="ZeroOrMore">
            <schema id="sc_Activities" name="Activities">
                <property id="sp_Activities_type" name="type" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Activities_description" name="description" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Activities_relatedGoal" name="relatedGoal" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Activities_dueDate" name="dueDate" type="string" multiplicity="ZeroOrOne" format="date"/>
                <property id="sp_Activities_status" name="status" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Activities_outcome" name="outcome" type="string" multiplicity="ZeroOrOne"/>
            </schema>
        </property>
        <property id="sp_ProgressReviews" name="ProgressReviews" type="object" multiplicity="ZeroOrMore">
            <schema id="sc_ProgressReviews" name="ProgressReviews">
                <property id="sp_ProgressReviews_date" name="date" type="string" multiplicity="ZeroOrOne" format="date"/>
                <property id="sp_ProgressReviews_onTrack" name="onTrack" type="boolean" multiplicity="ZeroOrOne"/>
                <property id="sp_ProgressReviews_notes" name="notes" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_ProgressReviews_adjustments" name="adjustments" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_ProgressReviews_planCompleted" name="planCompleted" type="boolean" multiplicity="ZeroOrOne"/>
            </schema>
        </property>
        <property id="sp_SelfAssessment" name="SelfAssessment" type="object" multiplicity="ZeroOrOne">
            <schema id="sc_SelfAssessment" name="SelfAssessment">
                <property id="sp_SelfAssessment_goalResults" name="goalResults" type="object" multiplicity="ZeroOrMore">
                    <schema id="sc_SelfAssessment_goalResults" name="goalResults">
                        <property id="sp_SelfAssessment_goalResults_goalTitle" name="goalTitle" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_SelfAssessment_goalResults_result" name="result" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_SelfAssessment_goalResults_comments" name="comments" type="string" multiplicity="ZeroOrOne"/>
                    </schema>
                </property>
                <property id="sp_SelfAssessment_summary" name="summary" type="string" multiplicity="ZeroOrOne"/>
            </schema>
        </property>
        <property id="sp_Evaluation" name="Evaluation" type="object" multiplicity="ZeroOrOne">
            <schema id="sc_Evaluation" name="Evaluation">
                <property id="sp_Evaluation_outcome" name="outcome" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Evaluation_summary" name="summary" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_Evaluation_goalResults" name="goalResults" type="object" multiplicity="ZeroOrMore">
                    <schema id="sc_Evaluation_goalResults" name="goalResults">
                        <property id="sp_Evaluation_goalResults_goalTitle" name="goalTitle" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_Evaluation_goalResults_result" name="result" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_Evaluation_goalResults_comments" name="comments" type="string" multiplicity="ZeroOrOne"/>
                    </schema>
                </property>
                <property id="sp_Evaluation_furtherDevelopment" name="furtherDevelopment" type="boolean" multiplicity="ZeroOrOne"/>
            </schema>
        </property>
        <property id="sp_PreviousRounds" name="PreviousRounds" type="object" multiplicity="ZeroOrMore">
            <schema id="sc_PreviousRounds" name="PreviousRounds">
                <property id="sp_PreviousRounds_period" name="period" type="string" multiplicity="ZeroOrOne"/>
                <property id="sp_PreviousRounds_plan" name="plan" type="object" multiplicity="ZeroOrOne">
                    <schema id="sc_PreviousRounds_plan" name="plan">
                        <property id="sp_PreviousRounds_plan_period" name="period" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_plan_goals" name="goals" type="object" multiplicity="ZeroOrMore">
                            <schema id="sc_PreviousRounds_plan_goals" name="goals">
                                <property id="sp_PreviousRounds_plan_goals_title" name="title" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_plan_goals_type" name="type" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_plan_goals_description" name="description" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_plan_goals_successCriteria" name="successCriteria" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_plan_goals_targetDate" name="targetDate" type="string" multiplicity="ZeroOrOne" format="date"/>
                            </schema>
                        </property>
                    </schema>
                </property>
                <property id="sp_PreviousRounds_approval" name="approval" type="object" multiplicity="ZeroOrOne">
                    <schema id="sc_PreviousRounds_approval" name="approval">
                        <property id="sp_PreviousRounds_approval_decision" name="decision" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_approval_comments" name="comments" type="string" multiplicity="ZeroOrOne"/>
                    </schema>
                </property>
                <property id="sp_PreviousRounds_selfAssessment" name="selfAssessment" type="object" multiplicity="ZeroOrOne">
                    <schema id="sc_PreviousRounds_selfAssessment" name="selfAssessment">
                        <property id="sp_PreviousRounds_selfAssessment_goalResults" name="goalResults" type="object" multiplicity="ZeroOrMore">
                            <schema id="sc_PreviousRounds_selfAssessment_goalResults" name="goalResults">
                                <property id="sp_PreviousRounds_selfAssessment_goalResults_goalTitle" name="goalTitle" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_selfAssessment_goalResults_result" name="result" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_selfAssessment_goalResults_comments" name="comments" type="string" multiplicity="ZeroOrOne"/>
                            </schema>
                        </property>
                        <property id="sp_PreviousRounds_selfAssessment_summary" name="summary" type="string" multiplicity="ZeroOrOne"/>
                    </schema>
                </property>
                <property id="sp_PreviousRounds_evaluation" name="evaluation" type="object" multiplicity="ZeroOrOne">
                    <schema id="sc_PreviousRounds_evaluation" name="evaluation">
                        <property id="sp_PreviousRounds_evaluation_outcome" name="outcome" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_evaluation_summary" name="summary" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_evaluation_goalResults" name="goalResults" type="object" multiplicity="ZeroOrMore">
                            <schema id="sc_PreviousRounds_evaluation_goalResults" name="goalResults">
                                <property id="sp_PreviousRounds_evaluation_goalResults_goalTitle" name="goalTitle" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_evaluation_goalResults_result" name="result" type="string" multiplicity="ZeroOrOne"/>
                                <property id="sp_PreviousRounds_evaluation_goalResults_comments" name="comments" type="string" multiplicity="ZeroOrOne"/>
                            </schema>
                        </property>
                        <property id="sp_PreviousRounds_evaluation_furtherDevelopment" name="furtherDevelopment" type="boolean" multiplicity="ZeroOrOne"/>
                    </schema>
                </property>
                <property id="sp_PreviousRounds_activities" name="activities" type="object" multiplicity="ZeroOrMore">
                    <schema id="sc_PreviousRounds_activities" name="activities">
                        <property id="sp_PreviousRounds_activities_type" name="type" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_activities_description" name="description" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_activities_relatedGoal" name="relatedGoal" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_activities_dueDate" name="dueDate" type="string" multiplicity="ZeroOrOne" format="date"/>
                        <property id="sp_PreviousRounds_activities_status" name="status" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_activities_outcome" name="outcome" type="string" multiplicity="ZeroOrOne"/>
                    </schema>
                </property>
                <property id="sp_PreviousRounds_progressReviews" name="progressReviews" type="object" multiplicity="ZeroOrMore">
                    <schema id="sc_PreviousRounds_progressReviews" name="progressReviews">
                        <property id="sp_PreviousRounds_progressReviews_date" name="date" type="string" multiplicity="ZeroOrOne" format="date"/>
                        <property id="sp_PreviousRounds_progressReviews_onTrack" name="onTrack" type="boolean" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_progressReviews_notes" name="notes" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_progressReviews_adjustments" name="adjustments" type="string" multiplicity="ZeroOrOne"/>
                        <property id="sp_PreviousRounds_progressReviews_planCompleted" name="planCompleted" type="boolean" multiplicity="ZeroOrOne"/>
                    </schema>
                </property>
            </schema>
        </property>
    </schema>
</type>
