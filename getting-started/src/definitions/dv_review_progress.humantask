<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="ReviewProgress" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Review progress. Owner: Manager. Starts on the 14-day timer or on Request early review, whichever comes first.]]></text>
        </documentation>
        <input id="i_Plan__review_progress" name="Plan" typeRef="dv_plan.type"/>
        <input id="i_Activities__review_progress" name="Activities" typeRef="dv_activity.type"/>
        <input id="i_ProgressReviews__review_progress" name="ProgressReviews" typeRef="dv_progressreview.type"/>
        <output id="o_ProgressReview__review_progress" name="ProgressReview" typeRef="dv_progressreview.type"/>
        <task-model>{
  "schema": {
    "title": "Review progress",
    "description": "Record how the plan is going. Tick \"The plan has been carried out\" to start the evaluation; otherwise the next check is in 14 days.",
    "type": "object",
    "required": [
      "ProgressReview"
    ],
    "properties": {
      "Plan": {
        "type": "object",
        "title": "Development plan",
        "properties": {
          "period": {
            "type": "string",
            "title": "Plan period"
          },
          "goals": {
            "type": "array",
            "title": "Goals",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "title": "Goal"
                },
                "type": {
                  "type": "string",
                  "title": "Type",
                  "oneOf": [
                    {
                      "const": "SKILL",
                      "title": "Skill"
                    },
                    {
                      "const": "KNOWLEDGE",
                      "title": "Knowledge"
                    },
                    {
                      "const": "BEHAVIOUR",
                      "title": "Behaviour"
                    },
                    {
                      "const": "CAREER",
                      "title": "Career"
                    }
                  ]
                },
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "successCriteria": {
                  "type": "string",
                  "title": "How we know it is achieved"
                },
                "targetDate": {
                  "type": "string",
                  "title": "Target date",
                  "format": "date"
                }
              }
            }
          }
        },
        "readOnly": true
      },
      "Activities": {
        "type": "array",
        "title": "Activities",
        "readOnly": true,
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "title": "Type",
              "oneOf": [
                {
                  "const": "PROJECT",
                  "title": "Project"
                },
                {
                  "const": "TRAINING",
                  "title": "Training"
                },
                {
                  "const": "COACHING",
                  "title": "Coaching"
                }
              ]
            },
            "description": {
              "type": "string",
              "title": "Activity"
            },
            "relatedGoal": {
              "type": "string",
              "title": "For goal"
            },
            "dueDate": {
              "type": "string",
              "title": "Due",
              "format": "date"
            },
            "status": {
              "type": "string",
              "title": "Status",
              "oneOf": [
                {
                  "const": "PLANNED",
                  "title": "Planned"
                },
                {
                  "const": "IN_PROGRESS",
                  "title": "In progress"
                },
                {
                  "const": "DONE",
                  "title": "Done"
                }
              ]
            },
            "outcome": {
              "type": "string",
              "title": "Outcome"
            }
          }
        }
      },
      "ProgressReviews": {
        "type": "array",
        "title": "Earlier reviews",
        "readOnly": true,
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "title": "Review date",
              "format": "date"
            },
            "onTrack": {
              "type": "boolean",
              "title": "On track"
            },
            "notes": {
              "type": "string",
              "title": "Notes"
            },
            "adjustments": {
              "type": "string",
              "title": "Adjustments to the plan"
            },
            "planCompleted": {
              "type": "boolean",
              "title": "The plan has been carried out"
            }
          }
        }
      },
      "ProgressReview": {
        "type": "object",
        "title": "Progress review",
        "x-on-complete": "addReview",
        "required": [
          "date",
          "notes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "title": "Review date",
            "format": "date"
          },
          "onTrack": {
            "type": "boolean",
            "title": "On track",
            "default": true
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          },
          "adjustments": {
            "type": "string",
            "title": "Adjustments to the plan"
          },
          "planCompleted": {
            "type": "boolean",
            "title": "The plan has been carried out",
            "default": false
          }
        }
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "Plan",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/Plan/properties/period"
          },
          {
            "type": "Control",
            "scope": "#/properties/Plan/properties/goals",
            "label": "Goals",
            "options": {
              "table": true
            }
          }
        ],
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Group",
        "label": "Activities",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/Activities",
            "label": false,
            "options": {
              "table": true
            }
          }
        ],
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Group",
        "label": "Earlier progress reviews",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/ProgressReviews",
            "label": false,
            "options": {
              "table": true
            }
          }
        ],
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Group",
        "label": "This review",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/ProgressReview/properties/date"
              },
              {
                "type": "Control",
                "scope": "#/properties/ProgressReview/properties/onTrack"
              }
            ]
          },
          {
            "type": "Control",
            "scope": "#/properties/ProgressReview/properties/notes",
            "options": {
              "multi": true
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/ProgressReview/properties/adjustments",
            "options": {
              "multi": true
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/ProgressReview/properties/planCompleted"
          }
        ]
      }
    ]
  },
  "submitLabel": "Save review"
}</task-model>
    </cafienne:implementation>
</humanTask>
