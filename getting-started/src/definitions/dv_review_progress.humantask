<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="ReviewProgress" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Review progress. Owner: Manager. Starts on the 14-day timer or on Request early review, whichever comes first.]]></text>
        </documentation>
        <input id="i_Plan__review_progress" name="Plan" typeRef="dv_plan.type"/>
        <input id="i_Activities__review_progress" name="Activities" typeRef="dv_activity.type"/>
        <input id="i_ProgressReviews__review_progress" name="ProgressReviews" typeRef="dv_progressreview.type"/>
        <output id="o_ProgressReview__review_progress" name="ProgressReview" typeRef="dv_progressreview.type"/>
        <task-model><![CDATA[{
  "schema": {
    "title": "Review progress",
    "description": "Record how the plan is going. Tick \"The plan has been carried out\" to start the evaluation; otherwise the next check is in 14 days.",
    "type": "object",
    "required": [
      "ProgressReview"
    ],
    "properties": {
      "Plan": {
        "type": "object",
        "title": "Development plan",
        "properties": {
          "period": {
            "type": "string",
            "title": "Plan period"
          },
          "goals": {
            "type": "array",
            "title": "Goals",
            "items": {
              "type": "object",
              "title": "Goal",
              "properties": {
                "title": {
                  "type": "string",
                  "title": "Goal"
                },
                "type": {
                  "type": "string",
                  "title": "Type",
                  "enum": [
                    "SKILL",
                    "KNOWLEDGE",
                    "BEHAVIOUR",
                    "CAREER"
                  ],
                  "enumNames": [
                    "Skill",
                    "Knowledge",
                    "Behaviour",
                    "Career"
                  ]
                },
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "successCriteria": {
                  "type": "string",
                  "title": "How we know it is achieved"
                },
                "targetDate": {
                  "type": "string",
                  "title": "Target date",
                  "format": "date"
                }
              },
              "required": [
                "title",
                "type",
                "successCriteria",
                "targetDate"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "period",
          "goals"
        ]
      },
      "Activities": {
        "type": "array",
        "title": "Activities in this round",
        "items": {
          "type": "object",
          "title": "Activity",
          "properties": {
            "type": {
              "type": "string",
              "title": "Type",
              "enum": [
                "PROJECT",
                "TRAINING",
                "COACHING"
              ],
              "enumNames": [
                "Project",
                "Training",
                "Coaching"
              ]
            },
            "description": {
              "type": "string",
              "title": "Description"
            },
            "relatedGoal": {
              "type": "string",
              "title": "Supports goal"
            },
            "dueDate": {
              "type": "string",
              "title": "Due date",
              "format": "date"
            },
            "status": {
              "type": "string",
              "title": "Status",
              "enum": [
                "PLANNED",
                "IN_PROGRESS",
                "DONE"
              ],
              "enumNames": [
                "Planned",
                "In progress",
                "Done"
              ]
            },
            "outcome": {
              "type": "string",
              "title": "Outcome"
            }
          }
        }
      },
      "ProgressReviews": {
        "type": "array",
        "title": "Progress reviews in this round",
        "items": {
          "type": "object",
          "title": "Review",
          "properties": {
            "date": {
              "type": "string",
              "title": "Review date",
              "format": "date"
            },
            "onTrack": {
              "type": "boolean",
              "title": "On track",
              "default": true
            },
            "notes": {
              "type": "string",
              "title": "Notes"
            },
            "adjustments": {
              "type": "string",
              "title": "Adjustments to the plan"
            },
            "planCompleted": {
              "type": "boolean",
              "title": "The plan has been carried out: start the evaluation",
              "default": false
            }
          }
        }
      },
      "ProgressReview": {
        "type": "object",
        "title": "Progress review",
        "properties": {
          "date": {
            "type": "string",
            "title": "Review date",
            "format": "date"
          },
          "onTrack": {
            "type": "boolean",
            "title": "On track",
            "default": true
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          },
          "adjustments": {
            "type": "string",
            "title": "Adjustments to the plan"
          },
          "planCompleted": {
            "type": "boolean",
            "title": "The plan has been carried out: start the evaluation",
            "default": false
          }
        },
        "required": [
          "date",
          "onTrack",
          "planCompleted"
        ]
      }
    }
  },
  "uiSchema": {
    "Plan": {
      "ui:order": [
        "period",
        "goals"
      ],
      "goals": {
        "items": {
          "ui:order": [
            "title",
            "type",
            "description",
            "successCriteria",
            "targetDate"
          ],
          "description": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          },
          "successCriteria": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          }
        },
        "ui:options": {
          "addable": false,
          "removable": false,
          "orderable": false
        },
        "ui:readonly": true
      },
      "ui:readonly": true
    },
    "Activities": {
      "items": {
        "ui:order": [
          "type",
          "description",
          "relatedGoal",
          "dueDate",
          "status",
          "outcome"
        ],
        "description": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        },
        "outcome": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        }
      },
      "ui:options": {
        "addable": false,
        "removable": false,
        "orderable": false
      },
      "ui:readonly": true
    },
    "ProgressReviews": {
      "items": {
        "ui:order": [
          "date",
          "onTrack",
          "notes",
          "adjustments",
          "planCompleted"
        ],
        "notes": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        },
        "adjustments": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        }
      },
      "ui:options": {
        "addable": false,
        "removable": false,
        "orderable": false
      },
      "ui:readonly": true
    },
    "ProgressReview": {
      "ui:order": [
        "date",
        "onTrack",
        "notes",
        "adjustments",
        "planCompleted"
      ],
      "notes": {
        "ui:widget": "textarea",
        "ui:options": {
          "rows": 3
        }
      },
      "adjustments": {
        "ui:widget": "textarea",
        "ui:options": {
          "rows": 3
        }
      }
    },
    "ui:order": [
      "Plan",
      "Activities",
      "ProgressReviews",
      "ProgressReview"
    ]
  },
  "submitLabel": "Save review"
}]]></task-model>
    </cafienne:implementation>
</humanTask>
