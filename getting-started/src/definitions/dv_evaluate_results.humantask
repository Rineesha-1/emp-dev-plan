      ],
      "properties": {
        "Plan": {
          "type": "object",
          "title": "Development plan",
          "properties": {
            "period": {
              "type": "string",
              "title": "Plan period"
            },
            "goals": {
              "type": "array",
              "title": "Goals",
              "items": {
                "type": "object",
                "title": "Goal",
                "properties": {
                  "title": {
                    "type": "string",
                    "title": "Goal"
                  },
                  "type": {
                    "type": "string",
                    "title": "Type",
                    "oneOf": [
                      {
                        "const": "SKILL",
                        "title": "Skill"
                      },
                      {
                        "const": "KNOWLEDGE",
                        "title": "Knowledge"
                      },
                      {
                        "const": "BEHAVIOUR",
                        "title": "Behaviour"
                      },
                      {
                        "const": "CAREER",
                        "title": "Career"
                      }
                    ]
                  },
                  "description": {
                    "type": "string",
