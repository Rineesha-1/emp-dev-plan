                  "successCriteria",
                  "targetDate"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "period",
            "goals"
          ]
        },
        "Activities": {
          "type": "array",
          "title": "Activities in this round",
          "items": {
            "type": "object",
            "title": "Activity",
            "properties": {
              "type": {
                "type": "string",
                "title": "Type",
                "oneOf": [
                  {
                    "const": "PROJECT",
                    "title": "Project"
                  },
                  {
                    "const": "TRAINING",
                    "title": "Training"
                  },
                  {
                    "const": "COACHING",
