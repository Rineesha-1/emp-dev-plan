    "submitLabel": "Save evaluation",
    "uischema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Development plan",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/Plan/properties/period",
              "options": {
                "readonly": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/Plan/properties/goals",
              "options": {
                "showSortButtons": false,
                "elementLabelProp": "title",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/title",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/type",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/description",
                      "options": {
                        "multi": true,
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/successCriteria",
                      "options": {
                        "multi": true,
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/targetDate",
                      "options": {
                        "readonly": true
                      }
                    }
                  ]
                },
                "disableAdd": true,
                "disableRemove": true,
                "readonly": true
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Activities in this round",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/Activities",
              "label": false,
              "options": {
                "disableAdd": true,
                "disableRemove": true,
                "showSortButtons": false,
                "elementLabelProp": "description",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/type",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/description",
                      "options": {
                        "multi": true,
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/relatedGoal",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/dueDate",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/status",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/outcome",
                      "options": {
                        "multi": true,
                        "readonly": true
                      }
                    }
                  ]
                },
                "readonly": true
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Progress reviews in this round",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/ProgressReviews",
              "label": false,
              "options": {
                "disableAdd": true,
                "disableRemove": true,
                "showSortButtons": false,
                "elementLabelProp": "date",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/date",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/onTrack",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/notes",
                      "options": {
                        "multi": true,
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/adjustments",
                      "options": {
                        "multi": true,
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/planCompleted",
                      "options": {
                        "readonly": true
                      }
                    }
                  ]
                },
                "readonly": true
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Self-assessment",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/SelfAssessment/properties/goalResults",
              "options": {
                "showSortButtons": false,
                "elementLabelProp": "goalTitle",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/goalTitle",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/result",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/comments",
                      "options": {
                        "multi": true,
                        "readonly": true
                      }
                    }
                  ]
                },
                "disableAdd": true,
                "disableRemove": true,
                "readonly": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/SelfAssessment/properties/summary",
              "options": {
                "multi": true,
                "readonly": true
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Evaluation",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/Evaluation/properties/outcome"
            },
            {
              "type": "Control",
              "scope": "#/properties/Evaluation/properties/summary",
              "options": {
                "multi": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/Evaluation/properties/goalResults",
              "options": {
                "showSortButtons": false,
                "elementLabelProp": "goalTitle",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/goalTitle",
                      "options": {
                        "readonly": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/result"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/comments",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                "disableAdd": true,
                "disableRemove": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/Evaluation/properties/furtherDevelopment"
            }
          ]
        }
      ]
    }
  },
  "output": "Evaluation"
}]]></task-model>
    </cafienne:implementation>
</humanTask>
