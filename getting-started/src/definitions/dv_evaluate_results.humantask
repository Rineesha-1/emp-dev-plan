<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="EvaluateResults" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Evaluate & document results. Owner: Manager. Also copies the finished round (plan, approval, activities, reviews, self-assessment, evaluation) into PreviousRounds.]]></text>
        </documentation>
        <input id="i_Plan__evaluate_results" name="Plan"/>
        <input id="i_Activities__evaluate_results" name="Activities"/>
        <input id="i_ProgressReviews__evaluate_results" name="ProgressReviews"/>
        <input id="i_SelfAssessment__evaluate_results" name="SelfAssessment"/>
        <input id="i_Evaluation__evaluate_results" name="Evaluation"/>
        <output id="o_Evaluation__evaluate_results" name="Evaluation"/>
        <task-model><![CDATA[{
  "schema": {
    "title": "Evaluate & document results",
    "description": "Record the result per goal and overall. Tick \"Further development needed\" to start a new plan round; otherwise the plan is closed.",
    "type": "object",
    "required": [
      "Evaluation"
    ],
    "properties": {
      "Plan": {
        "type": "object",
        "title": "Development plan",
        "properties": {
          "period": {
            "type": "string",
            "title": "Plan period"
          },
          "goals": {
            "type": "array",
            "title": "Goals",
            "items": {
              "type": "object",
              "title": "Goal",
              "properties": {
                "title": {
                  "type": "string",
                  "title": "Goal"
                },
                "type": {
                  "type": "string",
                  "title": "Type",
                  "enum": [
                    "SKILL",
                    "KNOWLEDGE",
                    "BEHAVIOUR",
                    "CAREER"
                  ],
                  "enumNames": [
                    "Skill",
                    "Knowledge",
                    "Behaviour",
                    "Career"
                  ]
                },
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "successCriteria": {
                  "type": "string",
                  "title": "How we know it is achieved"
                },
                "targetDate": {
                  "type": "string",
                  "title": "Target date",
                  "format": "date"
                }
              },
              "required": [
                "title",
                "type",
                "successCriteria",
                "targetDate"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "period",
          "goals"
        ]
      },
      "Activities": {
        "type": "array",
        "title": "Activities in this round",
        "items": {
          "type": "object",
          "title": "Activity",
          "properties": {
            "type": {
              "type": "string",
              "title": "Type",
              "enum": [
                "PROJECT",
                "TRAINING",
                "COACHING"
              ],
              "enumNames": [
                "Project",
                "Training",
                "Coaching"
              ]
            },
            "description": {
              "type": "string",
              "title": "Description"
            },
            "relatedGoal": {
              "type": "string",
              "title": "Supports goal"
            },
            "dueDate": {
              "type": "string",
              "title": "Due date",
              "format": "date"
            },
            "status": {
              "type": "string",
              "title": "Status",
              "enum": [
                "PLANNED",
                "IN_PROGRESS",
                "DONE"
              ],
              "enumNames": [
                "Planned",
                "In progress",
                "Done"
              ]
            },
            "outcome": {
              "type": "string",
              "title": "Outcome"
            }
          }
        }
      },
      "ProgressReviews": {
        "type": "array",
        "title": "Progress reviews in this round",
        "items": {
          "type": "object",
          "title": "Review",
          "properties": {
            "date": {
              "type": "string",
              "title": "Review date",
              "format": "date"
            },
            "onTrack": {
              "type": "boolean",
              "title": "On track",
              "default": true
            },
            "notes": {
              "type": "string",
              "title": "Notes"
            },
            "adjustments": {
              "type": "string",
              "title": "Adjustments to the plan"
            },
            "planCompleted": {
              "type": "boolean",
              "title": "The plan has been carried out: start the evaluation",
              "default": false
            }
          }
        }
      },
      "SelfAssessment": {
        "type": "object",
        "title": "Self-assessment",
        "properties": {
          "goalResults": {
            "type": "array",
            "title": "Results per goal",
            "items": {
              "type": "object",
              "title": "Goal result",
              "properties": {
                "goalTitle": {
                  "type": "string",
                  "title": "Goal"
                },
                "result": {
                  "type": "string",
                  "title": "Result",
                  "enum": [
                    "EXCEEDED",
                    "MET",
                    "PARTIALLY_MET",
                    "NOT_MET"
                  ],
                  "enumNames": [
                    "Exceeded",
                    "Met",
                    "Partially met",
                    "Not met"
                  ]
                },
                "comments": {
                  "type": "string",
                  "title": "Comments"
                }
              },
              "required": [
                "goalTitle",
                "result"
              ]
            }
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "required": [
          "summary"
        ]
      },
      "Evaluation": {
        "type": "object",
        "title": "Evaluation",
        "properties": {
          "outcome": {
            "type": "string",
            "title": "Outcome",
            "enum": [
              "MET",
              "PARTIALLY_MET",
              "NOT_MET"
            ],
            "enumNames": [
              "Met",
              "Partially met",
              "Not met"
            ]
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "goalResults": {
            "type": "array",
            "title": "Results per goal",
            "items": {
              "type": "object",
              "title": "Goal result",
              "properties": {
                "goalTitle": {
                  "type": "string",
                  "title": "Goal"
                },
                "result": {
                  "type": "string",
                  "title": "Result",
                  "enum": [
                    "EXCEEDED",
                    "MET",
                    "PARTIALLY_MET",
                    "NOT_MET"
                  ],
                  "enumNames": [
                    "Exceeded",
                    "Met",
                    "Partially met",
                    "Not met"
                  ]
                },
                "comments": {
                  "type": "string",
                  "title": "Comments"
                }
              },
              "required": [
                "goalTitle",
                "result"
              ]
            }
          },
          "furtherDevelopment": {
            "type": "boolean",
            "title": "Further development needed: start a new plan round",
            "default": false
          }
        },
        "required": [
          "outcome",
          "summary",
          "furtherDevelopment"
        ]
      }
    }
  },
  "uiSchema": {
    "Plan": {
      "ui:order": [
        "period",
        "goals"
      ],
      "goals": {
        "items": {
          "ui:order": [
            "title",
            "type",
            "description",
            "successCriteria",
            "targetDate"
          ],
          "description": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          },
          "successCriteria": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          }
        },
        "ui:options": {
          "addable": false,
          "removable": false,
          "orderable": false
        },
        "ui:readonly": true
      },
      "ui:readonly": true
    },
    "Activities": {
      "items": {
        "ui:order": [
          "type",
          "description",
          "relatedGoal",
          "dueDate",
          "status",
          "outcome"
        ],
        "description": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        },
        "outcome": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        }
      },
      "ui:options": {
        "addable": false,
        "removable": false,
        "orderable": false
      },
      "ui:readonly": true
    },
    "ProgressReviews": {
      "items": {
        "ui:order": [
          "date",
          "onTrack",
          "notes",
          "adjustments",
          "planCompleted"
        ],
        "notes": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        },
        "adjustments": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 3
          }
        }
      },
      "ui:options": {
        "addable": false,
        "removable": false,
        "orderable": false
      },
      "ui:readonly": true
    },
    "SelfAssessment": {
      "ui:order": [
        "goalResults",
        "summary"
      ],
      "goalResults": {
        "items": {
          "ui:order": [
            "goalTitle",
            "result",
            "comments"
          ],
          "comments": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          }
        },
        "ui:options": {
          "addable": false,
          "removable": false,
          "orderable": false
        },
        "ui:readonly": true
      },
      "summary": {
        "ui:widget": "textarea",
        "ui:options": {
          "rows": 3
        }
      },
      "ui:readonly": true
    },
    "Evaluation": {
      "ui:order": [
        "outcome",
        "summary",
        "goalResults",
        "furtherDevelopment"
      ],
      "summary": {
        "ui:widget": "textarea",
        "ui:options": {
          "rows": 3
        }
      },
      "goalResults": {
        "items": {
          "ui:order": [
            "goalTitle",
            "result",
            "comments"
          ],
          "comments": {
            "ui:widget": "textarea",
            "ui:options": {
              "rows": 3
            }
          },
          "goalTitle": {
            "ui:readonly": true
          }
        },
        "ui:options": {
          "addable": false,
          "removable": false,
          "orderable": false
        }
      }
    },
    "ui:order": [
      "Plan",
      "Activities",
      "ProgressReviews",
      "SelfAssessment",
      "Evaluation"
    ]
  },
  "jsonforms": {
    "schema": {
      "title": "Evaluate & document results",
      "description": "Record the result per goal and overall. Tick \"Further development needed\" to start a new plan round; otherwise the plan is closed.",
      "type": "object",
      "required": [
