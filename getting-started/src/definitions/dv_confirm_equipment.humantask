<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="ConfirmEquipment" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Confirm equipment received. Owner: the new employee. The issued assets come from the devplan database (x-store "assets", read-only here); the employee confirms receipt and can report anything missing (x-store "onboarding").]]></text>
        </documentation>
        <input id="i_Employee__confirm_equipment" name="Employee" typeRef="dv_employee.type"/>
        <task-model>{
  "schema": {
    "title": "Confirm equipment received",
    "description": "Check the equipment IT issued to you and confirm you received it. Tell us if anything is missing or damaged.",
    "type": "object",
    "properties": {
      "Equipment": {
        "type": "array",
        "title": "Issued to you",
        "x-store": "assets",
        "readOnly": true,
        "items": {
          "type": "object",
          "properties": {
            "assetType": {
              "type": "string", "title": "Type",
              "oneOf": [
                { "const": "LAPTOP", "title": "Laptop" },
                { "const": "MONITOR", "title": "Monitor" },
                { "const": "PHONE", "title": "Phone" },
                { "const": "ACCESS_BADGE", "title": "Access badge" },
                { "const": "DOCKING_STATION", "title": "Docking station" },
                { "const": "HEADSET", "title": "Headset" },
                { "const": "KEYBOARD_MOUSE", "title": "Keyboard &amp; mouse" },
                { "const": "OTHER", "title": "Other" }
              ]
            },
            "model": { "type": "string", "title": "Model" },
            "assetNumber": { "type": "string", "title": "Asset no." },
            "issuedOn": { "type": "string", "title": "Issued", "format": "date" }
          }
        }
      },
      "Confirmation": {
        "type": "object",
        "x-store": "onboarding",
        "x-on-complete": "confirmEquipment",
        "properties": {
          "equipmentReceived": { "type": "boolean", "title": "I received all the equipment listed above" },
          "equipmentNote": { "type": "string", "title": "Anything missing or damaged?" }
        }
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "Your equipment",
        "elements": [
          { "type": "Control", "scope": "#/properties/Equipment",
            "options": { "table": true, "readonly": true, "disableAdd": true, "disableRemove": true } }
        ]
      },
      {
        "type": "Group",
        "label": "Confirmation",
        "elements": [
          { "type": "Control", "scope": "#/properties/Confirmation/properties/equipmentReceived" },
          { "type": "Control", "scope": "#/properties/Confirmation/properties/equipmentNote", "options": { "multi": true } }
        ]
      }
    ]
  },
  "submitLabel": "Confirm"
}</task-model>
    </cafienne:implementation>
</humanTask>
