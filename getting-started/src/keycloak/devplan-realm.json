{
  "realm": "devplan",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Works on their own development plan" },
      { "name": "manager", "description": "Approves, reviews and evaluates development plans" },
      { "name": "hr", "description": "HR: sees and starts development cases for all employees" }
    ]
  },
  "clients": [
    {
      "clientId": "devplan-web",
      "name": "Development plan app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8090/*"],
      "webOrigins": ["http://localhost:8090"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:8090/*" }
    },
    {
      "clientId": "case-user-interface",
      "name": "CaseFabric Case UI",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3317/*"],
      "webOrigins": ["http://localhost:3317"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:3317/*" }
    },
    {
      "clientId": "swagger-ui",
      "name": "Case engine Swagger UI (Authorize button at http://localhost:2027)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "redirectUris": ["http://localhost:2027/*"],
      "webOrigins": ["http://localhost:2027"]
    },
    {
      "clientId": "devplan-backend",
      "name": "Development plan backend (registers users in the case engine tenant)",
      "publicClient": false,
      "secret": "devplan-backend-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
